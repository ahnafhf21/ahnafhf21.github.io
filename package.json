{
  "name": "ahnafhf21-portfolio",
  "private": true,
  "scripts": {
    "css:watch": "tailwindcss -i ./_tailwind/input.css -o ./assets/css/tailwind.css --watch",
    "css:build": "tailwindcss -i ./_tailwind/input.css -o ./assets/css/tailwind.css --minify",
    "jekyll:serve": "bundle exec jekyll serve",
    "build": "npm run css:build && bundle exec jekyll build"
  },
  "devDependencies": { "tailwindcss": "^3.4.17" }
}
